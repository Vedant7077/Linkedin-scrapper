        "jsCode": "const seen = new Set();\n\nreturn items\n  .map(item => {\n    const slug = item.json.linkedin;\n    if (!slug) return null;\n\n    const url = `https://www.linkedin.com/in/${slug}/`;\n\n    // Only return if not already seen\n    if (!seen.has(url)) {\n      seen.add(url);\n      return { json: { linkedin_url: url } };\n    }\n    return null; // skip duplicates\n  })\n  .filter(Boolean); // remove nulls\n"
      },
